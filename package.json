    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.2",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4.3.1",
    "vite": "^6.2.3"
  }
}
